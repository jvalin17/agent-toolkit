# Agent Toolkit — environment variables read by hooks/, gate/ and scripts/.
# None are required. Copy to .env only if your shell or CI loads one; hooks read
# the process environment directly. Values shown are the defaults.

# ---- Host / mode -------------------------------------------------------------
# Force the host id instead of auto-detecting (claude-code, cursor, gemini,
# codex-cli, grok-build, windsurf). Decides stamp policy and hook payload shape.
AGENT_TOOLKIT_TOOL=
# One-session override of gates.json "mode" (minimal, tdd, planned, guarded,
# default, standard, safe).
AGENT_TOOLKIT_MODE=
# Any gates.json key can be overridden as AGENT_TOOLKIT_<KEY_UPPER>, e.g.:
AGENT_TOOLKIT_GATE_PROTECT=true
AGENT_TOOLKIT_REPORT_PROTECT=true
AGENT_TOOLKIT_SKILL_ROUTING=true
AGENT_TOOLKIT_EVAL_THRESHOLD=95
AGENT_TOOLKIT_CANARY=

# ---- Auto-continue -----------------------------------------------------------
# Cap on chained sessions for agent-toolkit-continue.
AGENT_TOOLKIT_MAX_SESSIONS=20
# Set to 1 to launch claude with --dangerously-skip-permissions on restart.
AGENT_TOOLKIT_SKIP_PERMISSIONS=

# ---- Signed gates (gate/) -------------------------------------------------------
# Shared HS256 secret (GitHub Actions + laptop). Prefer the *_FILE form locally.
AGENT_TOOLKIT_GATE_SECRET=
AGENT_TOOLKIT_GATE_SECRET_FILE=.gate/signing.key
# Legacy names for the same secret; still honoured.
AGENT_TOOLKIT_GATE_PRIVATE_KEY=
AGENT_TOOLKIT_GATE_PRIVATE_KEY_FILE=
# CI only — skip the redundant re-runs during attestation.
AGENT_TOOLKIT_ATTEST_SKIP_HOOK_TESTS=
AGENT_TOOLKIT_ATTEST_SKIP_GATE_TESTS=
# setup-signed-gates.sh: set to 1 to upload the secret to the GitHub repo.
AGENT_TOOLKIT_UPLOAD_GATE_SECRET=

# ---- Install / update scripts ----------------------------------------------------
# update.sh: set to 0 to skip git pull on session start.
AGENT_TOOLKIT_AUTO_PULL=1
# install.sh --sync-only: set to 1 for per-file sync output.
AGENT_TOOLKIT_SYNC_VERBOSE=

# ---- roles/learn.py (knowledge bootstrap, optional) ----------------------------------
ANTHROPIC_API_KEY=
LEARN_STUDY_MODEL=
LEARN_SYNTH_MODEL=
LEARN_FILTER_MODEL=
