{
  "id": "codex-cli",
  "rules_targets": ["AGENTS.md"],
  "skills_path": null,
  "hooks": "structural",
  "hooks_config": {
    "path": ".codex/config.toml",
    "format": "codex"
  },
  "pull": ["mcp", "cli"],
  "stamp_mode": "cli_stamp",
  "bootstrap": {
    "inject": [
      "rules/core.md",
      "rules/hosts/codex-cli.md",
      "rules/skills-index.md"
    ],
    "max_chars": 4000
  }
}
